# All VITE_* values are visible in the browser. Never use real credentials here.
VITE_API_BASE_URL=/api/v1/admin
VITE_APP_NAME=Billisan Admin
VITE_MOCK_AUTH=true
VITE_USE_MOCK_DATA=true
VITE_AUTH_BYPASS=false
# Fictitious UI demonstration credentials only; these do not secure an API.
VITE_DEMO_ADMIN_ID=
VITE_DEMO_ADMIN_PASSWORD=
