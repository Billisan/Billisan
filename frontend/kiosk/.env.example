# Public configuration, never credentials. The Pi WebSocket service lives in iot/pi.
VITE_PI_WS_URL=ws://localhost:5000/ws/v1/kiosk
VITE_PI_MOCK=true
# Optional preview served by a trusted local or same-origin authenticated proxy.
# The proxy must enforce authorization with short-lived sessions; no token in URL.
VITE_CAMERA_STREAM_BASE_URL=
