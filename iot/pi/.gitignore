# =====================================================================
# Billisan - Raspberry Pi (중앙 컨트롤러)
# =====================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 가상환경 ----
venv/
env/
.venv/
ENV/

# ---- 신호 로그 (런타임 생성) ----
# pi_orin_client.py의 _setup_signal_logger가 LOG_DIR(기본 ./logs)에 생성.
# 5MB 로테이션이라 .log.1 ~ .log.5 백업 파일도 함께 쌓인다.
logs/
*.log
*.log.[0-9]

# 구버전 호환: 예전에는 실행 디렉토리 바로 아래에 생성했음
kiosk_signals.log*
spring_signals.log*
orin_signals.log*

# ---- 로컬 설정 오버라이드 ----
# 기기마다 IP·포트가 달라 로컬에서만 바꿔 쓰는 경우 대비.
# (현재는 billisan/config.py에 상수로 직접 관리하므로 해당 파일이 없을 수 있음)
.env
.env.local
*.local.py
config.local.py

# ---- 인증서 / 키 (mTLS 적용 시) ----
# 현재는 평문/익명 접속이지만, 나중에 MQTT mTLS를 붙이면 여기에 인증서가 놓인다.
*.pem
*.key
*.crt
*.p12
certs/

# ---- 테스트 / 임시 ----
*.tmp
*.bak
*.orig
.pytest_cache/
.coverage
htmlcov/

# ---- IDE / 편집기 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# =====================================================================
# 참고: 아래는 '커밋해야 하는' 파일들이다 (실수로 무시되지 않도록 명시)
#   pi_service.py          진입점
#   billisan/pi_orin_client.py      Orin ZeroMQ 클라이언트
#   billisan/*.py          서비스 패키지
#   requirements.txt       의존성 목록 (pip freeze 결과 - 있으면 커밋 권장)
# =====================================================================